generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  firstName String
  lastName  String?
  password  String
  posts     Posts[]
}

model Posts {
  id         Int      @id @default(autoincrement())
  title      String?
  content    String?
  createdAt  DateTime @default(now())
  updated_at DateTime @updatedAt
  author     User     @relation(fields: [authorId], references: [id])
  authorId   Int
}